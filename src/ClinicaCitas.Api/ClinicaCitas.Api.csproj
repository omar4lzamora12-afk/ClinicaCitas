<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClinicaCitas.Api</RootNamespace>
    <AssemblyName>ClinicaCitas.Api</AssemblyName>

    <!-- Genera el XML con los comentarios /// para que Swagger muestre la documentación de cada endpoint -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Permite ejecutar la API aunque solo tengas instalado un runtime más nuevo (.NET 9 o 10) -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger / OpenAPI: documentación interactiva de los endpoints -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
